{
  "name": "zuhause",
  "version": "0.7.0",
  "description": "homemgmt-ng – Lager, Haus in 3D und Küchenplaner in einer Webanwendung",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "VITE_DEV=1 node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=web/app/src server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.cjs\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "cert": "sh scripts/make-cert.sh",
    "reset-password": "node --no-warnings=ExperimentalWarning scripts/reset-password.cjs",
    "icons": "node scripts/make-icons.cjs",
    "test:e2e": "node test/e2e/app.smoke.mjs",
    "import-prod": "node --disable-warning=ExperimentalWarning scripts/import-prod.ts",
    "import-prod-items": "node --disable-warning=ExperimentalWarning scripts/import-prod-items.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "express": "^5.2.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "^0.0.26",
    "three-mesh-bvh": "^0.9.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
